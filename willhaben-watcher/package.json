{
  "name": "willhaben-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker: durchsucht die willhaben-Gebrauchtwagenbörse periodisch und meldet neue Treffer per Telegram.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:single": "esbuild src/index.ts --bundle --format=esm --target=es2022 --loader:.html=text --outfile=dashboard/worker.js",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "kv:create": "wrangler kv namespace create WATCHER"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.115.0"
  }
}
