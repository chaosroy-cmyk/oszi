{
  "name": "willhaben-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker: durchsucht die willhaben-Gebrauchtwagenbörse periodisch und meldet neue Treffer per Telegram.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "kv:create": "wrangler kv namespace create WATCHER"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.115.0"
  }
}
